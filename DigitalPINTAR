let activeCategory="Semua";
function render(){
 const q=document.getElementById("search").value.trim().toLowerCase();
 const filtered=articles.filter(a=>(activeCategory==="Semua"||a.cat===activeCategory)&&(`${a.title} ${a.desc} ${a.cat} ${a.intro}`).toLowerCase().includes(q));
 document.getElementById("cards").innerHTML=filtered.length?filtered.map(a=>`
 <article class="card">
 <div class="card-top">${a.icon}</div>
 <div class="card-body">
 <span class="tag">${a.cat}</span>
 <h3>${a.title}</h3>
 <p>${a.desc}</p>
 <button class="read" onclick="openArticle(${a.id})">Baca tutorial →</button>
 </div></article>`).join(""):`<div class="empty">Artikel tidak ditemukan. Coba kata kunci lain.</div>`;
}
function setCategory(cat,btn){
 activeCategory=cat;
 document.querySelectorAll(".chip").forEach(b=>b.classList.toggle("active",b.textContent.trim()===(cat==="Semua"?"Semua":cat)));
 render();
}
function openArticle(id){
 const a=articles.find(x=>x.id===id);
 if(!a)return;
 document.getElementById("home").style.display="none";
 document.getElementById("articleView").style.display="block";
 document.getElementById("articleContent").innerHTML=`
 <span class="tag">${a.cat} · Tutorial ${String(a.id).padStart(2,"0")}</span>
 <h1>${a.title}</h1><p class="intro">${a.intro}</p>
 ${a.body}
 <div class="exercise"><details><summary>📝 Latihan mandiri</summary><p>${a.exercise}</p><p><b>Tips:</b> Coba kerjakan sendiri dahulu, lalu periksa kembali hasilnya.</p></details></div>`;
 window.scrollTo(0,0);
}
function home(){
 document.getElementById("articleView").style.display="none";
 document.getElementById("home").style.display="block";
}
function privacy(){
 home();
 alert("Kebijakan Privasi: Situs ini merupakan proyek edukasi. Jika menambahkan analitik, formulir, atau iklan pihak ketiga, jelaskan data yang dikumpulkan, tujuan penggunaannya, dan cara pengguna mengelola data. Buat halaman kebijakan privasi lengkap sebelum mengaktifkan layanan iklan.");
}
document.getElementById("search").addEventListener("input",render);
render();
</script>
